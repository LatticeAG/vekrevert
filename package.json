{
  "name": "vekrevert",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:migrations": "vitest run tests/migrations.test.ts",
    "conformance": "vitest run tests/conformance.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:parity": "tsx scripts/check_parity.ts",
    "vekrevert": "tsx packages/cli/src/bin.ts",
    "generate:conformance": "tsx scripts/generate_conformance.ts"
  },
  "devDependencies": {
    "@latticeag/vekrevert": "workspace:*",
    "@latticeag/vekrevert-cli": "workspace:*",
    "@latticeag/vekrevert-compensators": "workspace:*",
    "@latticeag/vekrevert-core": "workspace:*",
    "@latticeag/vekrevert-events": "workspace:*",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
