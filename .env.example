# Copy to .env. Values are env-only; never put credentials in vekrevert.config.ts.
VEKREVERT_LEDGER=sqlite:./.vekrevert/ledger.db
VEKREVERT_AGENT_ID=billing-agent
VEKREVERT_ALLOW_DRAFTED=false
VEKREVERT_BLOCK_T4=false
VEKREVERT_LOG_LEVEL=info

# Optional. Prefix vr_live_ / vr_test_. Never commit the real value.
# VEKREVERT_API_KEY=

# Optional Ed25519 seed for hosted/attested mode.
# VEKREVERT_SIGNING_KEY=

# VekInbox (EP5). Required only when escalation.vekinbox is configured.
# VEKINBOX_API_KEY=
# VEKINBOX_WEBHOOK_SECRET=

# Model roles are null/disabled in v1. Set only if enabling Phase 8 later.
# VEKREVERT_MODEL_API_KEY=

# Compensator credential names resolve through credentials.map -> these env vars.
# STRIPE_SECRET_KEY=
